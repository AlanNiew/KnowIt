# =============================================================================
# KnowIt · compose 环境变量样例
# =============================================================================
# 用法：cp deploy/.env.example deploy/.env，按需修改。
# .env 已被 .gitignore 排除，不会进仓库。
# =============================================================================

# ---------- PostgreSQL ----------
DB_NAME=knowit
DB_USER=knowit
DB_PASSWORD=knowit
# 只绑回环。改成 0.0.0.0 前请先想清楚暴露边界。
DB_PORT=5432
TZ=Asia/Shanghai

# ---------- 应用（T0.3 起加入 compose） ----------
# 激活 db profile 才会连接数据库。见 knowit-server/src/main/resources/application-db.yml
SPRING_PROFILES_ACTIVE=db
KNOWIT_DB_USER=knowit
KNOWIT_DB_PASSWORD=knowit

# ---------- 本地推理端点（T0.3） ----------
# LLM：任何 OpenAI 兼容端点（vLLM / SGLang / llama.cpp / Ollama）
KNOWIT_LLM_URL=http://localhost:11434/v1
# Embedding / Rerank：Text Embeddings Inference
KNOWIT_EMBEDDING_URL=http://localhost:8081