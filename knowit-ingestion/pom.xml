<?xml version="1.0" encoding="UTF-8"?>
<!--
  knowit-ingestion：文档 ETL。
  api/IngestionPipeline   深模块（ADR-0008）：进文件流，出索引好的 chunk
  api/DocumentParser      解析 SPI（ADR-0009）：默认 Tika 实现，可换 OCR sidecar
  internal/               状态机、切分、向量化、双路索引的实现细节
  唯一的 langchain4j 引用点就在 internal/parser/ 下。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.knowit</groupId>
    <artifactId>knowit-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>knowit-ingestion</artifactId>
  <name>KnowIt :: Ingestion</name>
  <description>解析 → 清洗 → 切片 → 向量化 → 双路索引（ADR-0007 状态机）</description>

  <dependencies>
    <dependency>
      <groupId>com.knowit</groupId>
      <artifactId>knowit-domain</artifactId>
    </dependency>
    <dependency>
      <groupId>com.knowit</groupId>
      <artifactId>knowit-common</artifactId>
    </dependency>
  </dependencies>
</project>
